# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env -- ele contem credenciais do banco e o segredo do JWT.

# String de conexao do MySQL (Prisma)
DATABASE_URL="mysql://USUARIO:SENHA@HOST:3306/NOME_DO_BANCO"

# Segredo usado para assinar os tokens JWT -- gere um valor aleatorio forte
JWT_SECRET="troque-por-um-valor-aleatorio-longo"

# Porta do servidor Express
PORT=3000
