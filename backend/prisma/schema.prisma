generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Player {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  nickname    String   @default("")
  password    String
  level       Int      @default(1)
  xp          Int      @default(0)
  hp          Int      @default(100)
  bounty      BigInt   @default(0)
  berries     BigInt   @default(0)
  fruit_name    String?
  weapon_name   String?
  accessory_name String?
  weaponSlots   Json?
  fruitSlots    Json?
  haki        Json?
  race        String?
  race_rolls  Int      @default(3)
  fruit_rolls Int      @default(5)
  refine_weapon    Int      @default(0)
  refine_accessory Int      @default(0)
  fruit_awakened   Boolean  @default(false)
  training_atk     Int      @default(0)
  training_hp      Int      @default(0)
  world_progress Int   @default(1)
  unlocked_titles Json?
  equipped_title String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("player")
}